                <item android:offset="0.7" android:color="#220091EA" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Table Facet (Top Flat Center) -->
    <path
        android:pathData="M28,14 L68,14 L82,34 L14,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="14"
                android:startY="14"
                android:endX="82"
                android:endY="34"
                android:type="linear">
                <item android:offset="0.0" android:color="#B2EBF2" />
                <item android:offset="0.35" android:color="#E0F7FA" />
                <item android:offset="0.7" android:color="#80DEEA" />
