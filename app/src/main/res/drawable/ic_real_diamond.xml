    <!-- Ambient crystal soft glow behind diamond -->
    <path
        android:pathData="M48,8 L86,34 L48,90 L10,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="45"
                android:gradientRadius="44"
